[Unit]
Description=Verify the first scheduled format 2 collection and notify its owner
After=network-online.target
Wants=network-online.target
ConditionPathExists=!%h/.local/share/world-news-audit/operations/url-storage-v2-20261018/telegram-delivery.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/world-news-audit/bin/first-v2-collection-monitor.py --base %h/.local/share/world-news-audit --credentials %d/telegram-notify
LoadCredential=telegram-notify:%h/.config/world-news-audit/telegram-notify.json
Environment=TZ=UTC
UMask=0077
Nice=15
CPUQuota=25%
MemoryMax=256M
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/world-news-audit/operations/url-storage-v2-20261018 %h/.local/share/world-news-audit/state

