# Example only. These are the verified Oracle paths; inspect the current runner before use.
# Keep the real runtime.env owner-only (0600). Secret values do not belong here.
WNS_PORT=3401
WNS_QUALITY_MODE=cloud
WNS_QUALITY_REMOTE=0
WNS_QUALITY_PUBLIC_ORIGINS=https://news.bymyleslee.com
WNS_QUALITY_STATE_DIR=/home/ubuntu/.local/share/world-press-radar-quality/state
WNS_QUALITY_HISTORY_PATH=/home/ubuntu/.local/share/world-press-radar-quality/state/history.sqlite
WNS_QUALITY_RUNTIME_PATH=/home/ubuntu/.local/share/world-press-radar-quality/state/runtime.sqlite
WNS_REGISTRY_PATH=/home/ubuntu/.local/share/world-news-audit/current/data/rss-atlas.json
WNS_LEGACY_HEALTH_PATH=/home/ubuntu/.local/share/world-news-audit/current/audits/readme_rss_health_latest.json
WNS_HEALTH_PATH=/home/ubuntu/.local/share/world-news-audit/current/packages/world-news-sources-mcp/audits/health-latest.json
WNS_ACTIVITY_PATH=/home/ubuntu/.local/share/world-news-audit/current/packages/world-news-sources-mcp/activity/activity-snapshot.json
WNS_ACTIVITY_DB=/home/ubuntu/.local/share/world-news-audit/state/activity.sqlite
WNS_QUALITY_GATEWAY_TOKEN_FILE=/home/ubuntu/.config/world-press-radar-quality/gateway.token
# Enable manager access only after a private token has been configured.
# WNS_QUALITY_ADMIN_TOKEN_FILE=/home/ubuntu/.config/world-press-radar-quality/admin.token
# Paid providers stay disabled. Secret transfer/storage is a separate user decision.
WNS_OPENAI_PAID_APPROVED=0
WNS_JEV_PAID_APPROVED=0
WNS_QUALITY_TOTAL_BUDGET_USD=0
WNS_QUALITY_REPAIR_ENABLED=0
# If approved manager repair is enabled, use the verified collector repository root.
# WNS_QUALITY_REGISTRY_ROOT=/home/ubuntu/.local/share/world-news-audit/current
# WNS_QUALITY_REPAIR_STATE_DIR=/home/ubuntu/.local/share/world-news-audit/current/packages/world-news-sources-mcp/output/news-quality/repairs
# When the approved shared pilot budget has been reconciled, retain its original id:
# WNS_QUALITY_TOTAL_BUDGET_USD=5
# WNS_QUALITY_BUDGET_ID=news-quality-pilot-20261013
# WNS_QUALITY_BUDGET_PATH=/home/ubuntu/.local/share/world-press-radar-quality/state/runtime.sqlite
# WNS_OPENAI_KEY_FILE=/home/ubuntu/.config/world-press-radar-quality/model-secrets.env
# WNS_JEV_KEY_FILE=/home/ubuntu/.config/world-press-radar-quality/model-secrets.env
