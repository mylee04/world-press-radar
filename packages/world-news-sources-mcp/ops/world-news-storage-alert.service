[Unit]
Description=Warn the owner before shared disk space blocks news collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/world-news-audit/bin/shared-storage-alert.py --base %h/.local/share/world-news-audit --credentials %d/telegram-notify
LoadCredential=telegram-notify:%h/.config/world-news-audit/telegram-notify.json
Environment=TZ=UTC
UMask=0077
Nice=15
CPUQuota=10%
MemoryMax=128M
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/world-news-audit/state/storage-alert

