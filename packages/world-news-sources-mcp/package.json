{
  "name": "world-news-sources-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "World News Sources: read-only publisher RSS and sitemap metadata over MCP.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "start": "node dist/stdio.js",
    "smoke": "node test/smoke.mjs",
    "health:check": "node dist/check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "saxes": "6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
